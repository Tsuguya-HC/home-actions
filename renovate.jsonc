{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  // The aqua preset is pinned rather than floating: it owns which files the aqua
  // manager reads, and a preset-side change would silently re-scope this repo.
  "extends": [
    // config:best-practices = config:recommended + docker:pinDigests
    // + helpers:pinGitHubActionDigests + :configMigration + :pinDevDependencies
    // + abandonments:recommended + security:minimumReleaseAgeNpm
    // + :maintainLockFilesWeekly. The two presets listed separately before are
    // both inside it now.
    "config:best-practices",
    "github>aquaproj/aqua-renovate-config#2.13.0"
  ],

  // Baseline soak. Nothing here automerges, so this only affects when the PR opens.
  "minimumReleaseAge": "3 days",

  "customManagers": [
    {
      "description": [
        "The tool versions this repository hands to six others are `workflow_call`",
        "input defaults, which no manager reads on its own. Without this they are the",
        "one set of pins nothing maintains — in a repository whose entire reason to",
        "exist is that pins drift when nobody owns them."
      ],
      "customType": "regex",
      // Every reusable workflow here, not just lint-workflows.yml: lint-renovate.yml
      // pins the Renovate version the same way, and scoping this to one filename is
      // how the next one would end up unmaintained.
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+default: \"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    }
  ],

  "packageRules": [
    {
      "description": [
        "zizmor-action only accepts the versions listed in its own support/versions",
        "file, so bumping the version input without the action (or the reverse) fails",
        "at run time with `Unknown version`. Grouping them means the pair is never",
        "split across two PRs."
      ],
      "groupName": "zizmor",
      "matchPackageNames": [
        "zizmorcore/zizmor",
        "zizmorcore/zizmor-action"
      ]
    },
    {
      "description": [
        "This repository is a CI dependency of six others. Nothing here is urgent",
        "enough to justify merging a bump unattended, and a bad one breaks every",
        "caller's lint at once."
      ],
      // custom.regex covers the workflow_call input defaults above — those are the
      // pins the callers actually resolve, so they must not slip through either.
      "matchManagers": [
        "github-actions",
        "custom.regex"
      ],
      "automerge": false
    }
  ]
}
